import { useState, useEffect, useMemo, useCallback } from 'react';
import { useRouter } from 'next/router';
import Head from 'next/head';
import MainLayout from '../../components/layout/MainLayout';
import Button from '../../components/ui/Button';
import Input from '../../components/ui/Input';
import { useToast } from '../../hooks/useToast';
import { withPermission } from '../../utils/withPermission';
import { MenuPermissions } from '../../config/menu.permissions';
import apiClient from '../../lib/apiClient';
import { companyStore } from '../../lib/companyStore';
import CurrencySelector from '../../components/shared/CurrencySelector';
import PaymentMethodSelector from '../../components/shared/PaymentMethodSelector';
import { ExchangeRateField } from '../../components/ui/ExchangeRateField';
import WarehouseSelector from '../../components/common/WarehouseSelector';
import {
  TruckIcon,
  DocumentTextIcon,
  ShoppingCartIcon,
  DocumentDuplicateIcon,
  BriefcaseIcon,
  PencilSquareIcon,
  CheckCircleIcon,
  ArrowLeftIcon,
  ExclamationTriangleIcon,
  InformationCircleIcon,
  ChevronDownIcon,
  ChevronUpIcon,
  GlobeAltIcon,
  CurrencyDollarIcon,
  MapPinIcon,
  ClipboardDocumentListIcon,
  CubeIcon,
  ArrowPathIcon,
} from '@heroicons/react/24/outline';

// ─── Types ───────────────────────────────────────────────
interface ShipmentType { id: number; code: string; name_en: string; name_ar: string; is_active: boolean }
interface City { id: number; code: string; name: string; name_ar?: string; name_en?: string; country_id?: number; is_active: boolean }
interface Port { id: number; code: string; name: string; name_en: string; name_ar: string; port_type: 'sea' | 'air' | 'land'; country_id?: number; city_id?: number; country_name_en?: string; country_name_ar?: string }
interface Country { id: number; code: string; name: string; name_ar?: string; name_en?: string; is_active?: boolean }
interface Project { id: number; code: string; name: string; name_en?: string; name_ar?: string; project_type?: string }
interface Vendor { id: number; code: string; name: string; name_ar?: string }
interface Incoterm { id: number; code: string; name: string; name_ar: string; description: string; is_active: boolean }
interface ShippingAgent { id: number; code: string; name: string; name_ar: string; agent_type?: string; is_active?: boolean }

interface PurchaseOrder {
  id: number; order_number: string; vendor_id: number;
  vendor_name?: string; vendor_display_name?: string; vendor_contract_number?: string;
  project_id: number; project_code?: string; project_name?: string;
  total_amount: number; currency_id?: number; currency_code?: string; currency_symbol?: string;
  payment_method_id?: number; payment_method_name?: string; payment_terms_name?: string;
  incoterm?: string; delivery_terms_name?: string;
  origin_country_id?: number; origin_city_id?: number;
  destination_country_id?: number; destination_city_id?: number;
  port_of_loading_id?: number; port_of_loading_text?: string;
  port_of_discharge_id?: number; warehouse_id?: number;
  items: POItem[];
}
interface POItem { id: number; item_id: number; sku: string; name_en: string; name_ar: string; quantity: number; unit_id: number; unit_code: string; unit_price: number }

type SourceType = 'manual' | 'purchase_order' | 'rfq' | 'contract';

interface ShipmentForm {
  source_type: SourceType;
  purchase_order_id: number | null;
  shipment_number: string;
  shipment_type_id: number | '';
  project_id: number | '';
  vendor_id: number | null;
  incoterm: string;
  origin_country_id: number | '';
  destination_country_id: number | '';
  origin_location_id: number | '';
  destination_location_id: number | '';
  port_of_loading_id: number | '';
  port_of_loading_text: string;
  port_of_discharge_id: number | '';
  bl_no: string;
  awb_no: string;
  expected_arrival_date: string;
  departure_date: string;
  currency_id: number | '';
  exchange_rate: string;
  payment_method_id: number | null;
  payment_method_type: string;
  lc_number: string;
  letter_of_credit_id: number | null;
  total_amount: number;
  shipping_agent_id: number | '';
  warehouse_id: number | null;
  cargo_description: string;
  total_weight_kg: string;
  total_volume_cbm: string;
  packages_count: string;
  status_code: string;
  stage_code: string;
  notes: string;
}

// ─── Helper: Collapsible Section ─────────────────────────
function Section({ icon: Icon, title, subtitle, defaultOpen = true, badge, children }: {
  icon: any; title: string; subtitle?: string; defaultOpen?: boolean; badge?: string; children: React.ReactNode
}) {
  const [open, setOpen] = useState(defaultOpen);
  return (
    <div className="border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden transition-all">
      <button type="button" onClick={() => setOpen(!open)}
        className="w-full flex items-center gap-3 px-5 py-4 bg-gray-50 dark:bg-gray-800/50 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-left">
        <Icon className="w-5 h-5 text-blue-600 dark:text-blue-400 flex-shrink-0" />
        <div className="flex-1 min-w-0">
          <div className="flex items-center gap-2">
            <h2 className="text-sm font-semibold text-gray-900 dark:text-white">{title}</h2>
            {badge && <span className="px-2 py-0.5 text-[10px] font-medium bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 rounded-full">{badge}</span>}
          </div>
          {subtitle && <p className="text-xs text-gray-500 dark:text-gray-400 mt-0.5">{subtitle}</p>}
        </div>
        {open ? <ChevronUpIcon className="w-4 h-4 text-gray-400" /> : <ChevronDownIcon className="w-4 h-4 text-gray-400" />}
      </button>
      {open && <div className="px-5 py-4 space-y-4">{children}</div>}
    </div>
  );
}

// ─── Helper: Field hint ──────────────────────────────────
function Hint({ children }: { children: React.ReactNode }) {
  return (
    <p className="flex items-start gap-1 mt-1 text-xs text-gray-500 dark:text-gray-400">
      <InformationCircleIcon className="w-3.5 h-3.5 mt-0.5 flex-shrink-0 text-blue-400" />
      <span>{children}</span>
    </p>
  );
}

// ─── Helper: Completion bar ──────────────────────────────
function CompletionBar({ percent }: { percent: number }) {
  const color = percent < 30 ? 'bg-red-500' : percent < 60 ? 'bg-amber-500' : percent < 90 ? 'bg-blue-500' : 'bg-emerald-500';
  return (
    <div className="flex items-center gap-3">
      <div className="flex-1 h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
        <div className={`h-full ${color} rounded-full transition-all duration-500`} style={{ width: `${percent}%` }} />
      </div>
      <span className="text-xs font-medium text-gray-600 dark:text-gray-400 min-w-[3rem] text-right">{percent}%</span>
    </div>
  );
}

// ─── Source type cards config ────────────────────────────
const SOURCE_TYPES: { value: SourceType; icon: any; label: string; labelAr: string; desc: string; ready: boolean }[] = [
  { value: 'purchase_order', icon: ShoppingCartIcon, label: 'Purchase Order', labelAr: 'أمر شراء', desc: 'يملأ البيانات تلقائياً من أمر الشراء', ready: true },
  { value: 'manual', icon: PencilSquareIcon, label: 'Manual Entry', labelAr: 'إدخال يدوي', desc: 'إدخال جميع البيانات يدوياً', ready: true },
  { value: 'rfq', icon: DocumentDuplicateIcon, label: 'Price Quotation', labelAr: 'عرض سعر', desc: 'إنشاء من عرض سعر مُعتمد', ready: false },
  { value: 'contract', icon: BriefcaseIcon, label: 'Vendor Contract', labelAr: 'عقد مورد', desc: 'إنشاء من عقد توريد قائم', ready: false },
];

const SAUDI_ARABIA_CODE = 'SAU';

// ═════════════════════════════════════════════════════════
// ─── Main Component ──────────────────────────────────────
// ═════════════════════════════════════════════════════════
function CreateShipmentPage() {
  const router = useRouter();
  const { showToast } = useToast();

  const [loading, setLoading] = useState(false);
  const [success, setSuccess] = useState(false);
  const [newShipmentId, setNewShipmentId] = useState<number | null>(null);
  const [lookupLoading, setLookupLoading] = useState(true);

  // Lookups
  const [shipmentTypes, setShipmentTypes] = useState<ShipmentType[]>([]);
  const [countries, setCountries] = useState<Country[]>([]);
  const [originCities, setOriginCities] = useState<City[]>([]);
  const [destinationCities, setDestinationCities] = useState<City[]>([]);
  const [ports, setPorts] = useState<Port[]>([]);
  const [projects, setProjects] = useState<Project[]>([]);
  const [vendors, setVendors] = useState<Vendor[]>([]);
  const [purchaseOrders, setPurchaseOrders] = useState<PurchaseOrder[]>([]);
  const [incoterms, setIncoterms] = useState<Incoterm[]>([]);
  const [shippingAgents, setShippingAgents] = useState<ShippingAgent[]>([]);
  const [shipmentStatuses, setShipmentStatuses] = useState<{ id: number; code: string; name_en: string; name_ar: string }[]>([]);
  const [shipmentStages, setShipmentStages] = useState<{ id: number; code: string; name_en: string; name_ar: string }[]>([]);

  const [selectedPO, setSelectedPO] = useState<PurchaseOrder | null>(null);
  const [poItems, setPOItems] = useState<POItem[]>([]);
  const [selectedCurrencyCode, setSelectedCurrencyCode] = useState<string | null>(null);
  const [formErrors, setFormErrors] = useState<Record<string, string>>({});

  const getCompanyId = () => companyStore.getActiveCompanyId();

  const [formData, setFormData] = useState<ShipmentForm>({
    source_type: 'purchase_order',
    purchase_order_id: null,
    shipment_number: '',
    shipment_type_id: '',
    project_id: '',
    vendor_id: null,
    incoterm: 'FOB',
    origin_country_id: '',
    destination_country_id: '',
    origin_location_id: '',
    destination_location_id: '',
    port_of_loading_id: '',
    port_of_loading_text: '',
    port_of_discharge_id: '',
    bl_no: '',
    awb_no: '',
    expected_arrival_date: '',
    departure_date: '',
    currency_id: '',
    exchange_rate: '1',
    payment_method_id: null,
    payment_method_type: '',
    lc_number: '',
    letter_of_credit_id: null,
    total_amount: 0,
    shipping_agent_id: '',
    warehouse_id: null,
    cargo_description: '',
    total_weight_kg: '',
    total_volume_cbm: '',
    packages_count: '',
    status_code: 'draft',
    stage_code: '',
    notes: '',
  });

  const updateField = useCallback(<K extends keyof ShipmentForm>(key: K, value: ShipmentForm[K]) => {
    setFormData(prev => ({ ...prev, [key]: value }));
    if (formErrors[key]) setFormErrors(prev => { const n = { ...prev }; delete n[key]; return n; });
  }, [formErrors]);

  // ── Completion calculation ────────────────────────────
  const completionPercent = useMemo(() => {
    const checks = [
      !!formData.shipment_number,
      !!formData.shipment_type_id,
      !!formData.project_id,
      !!formData.incoterm,
      !!formData.origin_country_id && !!formData.origin_location_id,
      !!formData.destination_country_id && !!formData.destination_location_id,
      !!formData.port_of_discharge_id,
      !!formData.vendor_id,
      !!formData.currency_id,
      !!formData.total_amount,
    ];
    return Math.round((checks.filter(Boolean).length / checks.length) * 100);
  }, [formData]);

  // ── Load lookups ──────────────────────────────────────
  useEffect(() => { fetchLookups(); previewShipmentNumber(); }, []);

  const previewShipmentNumber = async () => {
    try {
      const res = await apiClient.get<{ success: boolean; number: string }>('/api/logistics-shipments/preview-number');
      if (res.number) setFormData(prev => ({ ...prev, shipment_number: res.number }));
    } catch { /* user can enter manually */ }
  };

  const safeArray = (data: any): any[] => Array.isArray(data) ? data : (data?.data && Array.isArray(data.data) ? data.data : []);

  const fetchLookups = async () => {
    setLookupLoading(true);
    try {
      const [typesRes, countriesRes, portsRes, projectsRes, vendorsRes, posRes, statusesRes, stagesRes, incotermsRes, agentsRes] = await Promise.all([
        apiClient.get('/api/logistics-shipment-types?limit=100').catch(() => ({ data: [] })),
        apiClient.get('/api/master/countries?limit=300').catch(() => ({ data: [] })),
        apiClient.get('/api/ports?limit=500').catch(() => ({ data: [] })),
        apiClient.get('/projects?limit=500&status=active').catch(() => ({ data: [] })),
        apiClient.get('/api/master/vendors?limit=500&is_active=true').catch(() => ({ data: [] })),
        apiClient.get('/api/procurement/purchase-orders?limit=200&exclude_with_shipments=true').catch(() => ({ data: [] })),
        apiClient.get('/api/shipment-lifecycle-statuses?limit=100').catch(() => ({ data: [] })),
        apiClient.get('/api/shipment-stages?limit=100').catch(() => ({ data: [] })),
        apiClient.get('/api/master/incoterms?limit=50').catch(() => ({ data: [] })),
        apiClient.get('/api/shipping-agents?limit=100').catch(() => ({ data: [] })),
      ]);

      setShipmentTypes(safeArray(typesRes.data));
      const countriesList = safeArray(countriesRes.data);
      setCountries(countriesList);
      setPorts(safeArray(portsRes.data));
      setProjects(safeArray(projectsRes.data));
      setVendors(safeArray(vendorsRes.data));
      setPurchaseOrders(safeArray(posRes.data));
      setShipmentStatuses(safeArray(statusesRes.data));
      setShipmentStages(safeArray(stagesRes.data));
      setIncoterms(safeArray(incotermsRes.data));
      setShippingAgents(safeArray(agentsRes.data));

      // Default destination = Saudi Arabia
      const saudi = countriesList.find((c: Country) => c.code === SAUDI_ARABIA_CODE);
      if (saudi) {
        setFormData(prev => ({ ...prev, destination_country_id: saudi.id }));
        loadCitiesFor('destination', saudi.id);
      }
    } catch (e: any) {
      showToast(e?.message || 'Failed to load data', 'error');
    } finally {
      setLookupLoading(false);
    }
  };

  // ── City cascading ────────────────────────────────────
  const loadCitiesFor = async (which: 'origin' | 'destination', countryId: number) => {
    if (!countryId) { which === 'origin' ? setOriginCities([]) : setDestinationCities([]); return; }
    try {
      const res = await apiClient.get(`/api/master/cities?country_id=${countryId}&limit=200`);
      const list = safeArray(res.data);
      which === 'origin' ? setOriginCities(list) : setDestinationCities(list);
    } catch { which === 'origin' ? setOriginCities([]) : setDestinationCities([]); }
  };

  const handleOriginCountryChange = (countryId: number) => {
    updateField('origin_country_id', countryId || '');
    updateField('origin_location_id', '');
    loadCitiesFor('origin', countryId);
  };

  const handleDestinationCountryChange = (countryId: number) => {
    updateField('destination_country_id', countryId || '');
    updateField('destination_location_id', '');
    loadCitiesFor('destination', countryId);
  };

  // ── PO Selection ──────────────────────────────────────
  const handlePOSelection = async (poId: number) => {
    if (!poId) { setSelectedPO(null); setPOItems([]); return; }
    try {
      const res = await apiClient.get(`/api/procurement/purchase-orders/${poId}`);
      const po: PurchaseOrder = res.data;
      setSelectedPO(po);
      setPOItems(po.items || []);

      if (po.origin_country_id) loadCitiesFor('origin', po.origin_country_id);
      if (po.destination_country_id) loadCitiesFor('destination', po.destination_country_id);

      setFormData(prev => ({
        ...prev,
        purchase_order_id: po.id,
        project_id: po.project_id || prev.project_id,
        vendor_id: po.vendor_id,
        currency_id: po.currency_id || prev.currency_id,
        payment_method_id: po.payment_method_id || prev.payment_method_id,
        total_amount: po.total_amount || 0,
        incoterm: po.incoterm || po.delivery_terms_name || prev.incoterm,
        origin_country_id: po.origin_country_id || prev.origin_country_id,
        origin_location_id: po.origin_city_id || prev.origin_location_id,
        destination_country_id: po.destination_country_id || prev.destination_country_id,
        destination_location_id: po.destination_city_id || prev.destination_location_id,
        port_of_loading_id: po.port_of_loading_id || prev.port_of_loading_id,
        port_of_loading_text: po.port_of_loading_text || prev.port_of_loading_text,
        port_of_discharge_id: po.port_of_discharge_id || prev.port_of_discharge_id,
        warehouse_id: po.warehouse_id || prev.warehouse_id,
      }));

      if (po.currency_code) setSelectedCurrencyCode(po.currency_code);
      showToast('تم تحميل بيانات أمر الشراء بنجاح | PO data loaded', 'success');
    } catch (e: any) {
      showToast(e?.message || 'فشل تحميل بيانات أمر الشراء', 'error');
    }
  };

  // ── Validation ────────────────────────────────────────
  const validateForm = (): boolean => {
    const errors: Record<string, string> = {};
    if (!formData.shipment_number.trim()) errors.shipment_number = 'رقم الشحنة مطلوب';
    if (!formData.shipment_type_id) errors.shipment_type_id = 'نوع الشحنة مطلوب';
    if (!formData.project_id) errors.project_id = 'المشروع مطلوب';
    if (!formData.incoterm.trim()) errors.incoterm = 'شروط التسليم مطلوبة';
    if (!formData.origin_country_id) errors.origin_country_id = 'بلد المنشأ مطلوب';
    if (!formData.origin_location_id) errors.origin_location_id = 'مدينة المنشأ مطلوبة';
    if (!formData.destination_country_id) errors.destination_country_id = 'بلد الوصول مطلوب';
    if (!formData.destination_location_id) errors.destination_location_id = 'مدينة الوصول مطلوبة';
    if (!formData.port_of_discharge_id) errors.port_of_discharge_id = 'ميناء الوصول مطلوب';
    if (formData.payment_method_type?.toLowerCase().includes('lc') || formData.payment_method_type?.toLowerCase().includes('letter')) {
      if (!formData.lc_number.trim()) errors.lc_number = 'رقم الاعتماد المستندي مطلوب';
    }
    setFormErrors(errors);
    return Object.keys(errors).length === 0;
  };

  // ── Submit ────────────────────────────────────────────
  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!validateForm()) {
      showToast('يرجى تعبئة الحقول المطلوبة | Please fill required fields', 'error');
      return;
    }
    setLoading(true);
    try {
      const payload: Record<string, any> = {
        shipment_number: formData.shipment_number.trim(),
        shipment_type_id: Number(formData.shipment_type_id),
        project_id: Number(formData.project_id),
        incoterm: formData.incoterm.trim().toUpperCase(),
        origin_location_id: Number(formData.origin_location_id),
        destination_location_id: Number(formData.destination_location_id),
        port_of_discharge_id: Number(formData.port_of_discharge_id),
        bl_no: formData.bl_no.trim() || null,
        awb_no: formData.awb_no.trim() || null,
        expected_arrival_date: formData.expected_arrival_date || null,
        departure_date: formData.departure_date || null,
        port_of_loading_id: formData.port_of_loading_id ? Number(formData.port_of_loading_id) : null,
        port_of_loading_text: formData.port_of_loading_text?.trim() || null,
        currency_id: formData.currency_id ? Number(formData.currency_id) : null,
        exchange_rate: parseFloat(formData.exchange_rate) || 1,
        payment_method_id: formData.payment_method_id || null,
        lc_number: formData.lc_number.trim() || null,
        letter_of_credit_id: formData.letter_of_credit_id || null,
        total_amount: formData.total_amount ? Number(formData.total_amount) : null,
        shipping_agent_id: formData.shipping_agent_id ? Number(formData.shipping_agent_id) : null,
        warehouse_id: formData.warehouse_id ? Number(formData.warehouse_id) : null,
        vendor_id: formData.vendor_id ? Number(formData.vendor_id) : null,
        purchase_order_id: formData.purchase_order_id ? Number(formData.purchase_order_id) : null,
        cargo_description: formData.cargo_description?.trim() || null,
        total_weight_kg: formData.total_weight_kg ? parseFloat(formData.total_weight_kg) : null,
        total_volume_cbm: formData.total_volume_cbm ? parseFloat(formData.total_volume_cbm) : null,
        packages_count: formData.packages_count ? parseInt(formData.packages_count) : null,
        status_code: formData.status_code || 'draft',
        stage_code: formData.stage_code || null,
        notes: formData.notes.trim() || null,
      };

      let res: any;
      if (formData.purchase_order_id) {
        res = await apiClient.post(`/api/logistics-shipments/from-purchase-order/${formData.purchase_order_id}`, payload);
        const d = res.data as any;
        setNewShipmentId(d?.shipment?.id ?? d?.id ?? null);
        showToast(`تم إنشاء الشحنة بنجاح مع ${d?.items_count || 0} صنف من أمر الشراء`, 'success');
      } else {
        res = await apiClient.post('/api/logistics-shipments', payload);
        setNewShipmentId(res.data?.id ?? null);
        showToast('تم إنشاء الشحنة بنجاح | Shipment created', 'success');
      }
      setSuccess(true);
    } catch (err: any) {
      let errorMsg = err.message || 'فشل إنشاء الشحنة';
      if (err?.data?.error?.details && Array.isArray(err.data.error.details)) {
        errorMsg = err.data.error.details.map((d: any) => `${d.path?.join('.') || 'Field'}: ${d.message}`).join('; ');
      }
      showToast(errorMsg, 'error');
    } finally {
      setLoading(false);
    }
  };

  // ── Filter ports by type based on shipment type ───────
  const selectedShipmentType = shipmentTypes.find(t => t.id === formData.shipment_type_id);
  const shipmentTypeCode = selectedShipmentType?.code?.toLowerCase() || '';
  const filteredPorts = useMemo(() => {
    if (shipmentTypeCode.includes('sea') || shipmentTypeCode.includes('ocean')) return ports.filter(p => p.port_type === 'sea');
    if (shipmentTypeCode.includes('air')) return ports.filter(p => p.port_type === 'air');
    if (shipmentTypeCode.includes('land') || shipmentTypeCode.includes('road')) return ports.filter(p => p.port_type === 'land');
    return ports;
  }, [ports, shipmentTypeCode]);

  const isPOSourced = formData.source_type === 'purchase_order' && !!selectedPO;

  // ═════════════════════════════════════════════════════
  // ─── Success Screen ─────────────────────────────────
  // ═════════════════════════════════════════════════════
  if (success && newShipmentId) {
    return (
      <MainLayout>
        <Head><title>تم إنشاء الشحنة - SLMS</title></Head>
        <div className="max-w-lg mx-auto py-16">
          <div className="bg-white dark:bg-gray-800 rounded-2xl shadow-xl p-10 text-center">
            <div className="w-20 h-20 mx-auto mb-6 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center">
              <CheckCircleIcon className="w-12 h-12 text-emerald-600 dark:text-emerald-400" />
            </div>
            <h1 className="text-2xl font-bold text-gray-900 dark:text-white mb-2">تم إنشاء الشحنة بنجاح</h1>
            <p className="text-gray-500 dark:text-gray-400 mb-6">الشحنة جاهزة للمتابعة والتتبع. يمكنك إضافة المزيد من التفاصيل لاحقاً.</p>
            <div className="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-3 mb-8 inline-block">
              <span className="text-sm text-blue-700 dark:text-blue-300 font-medium">#{newShipmentId}</span>
            </div>
            <div className="flex gap-3 justify-center">
              <Button onClick={() => router.push(`/shipments/${newShipmentId}`)} variant="primary">عرض التفاصيل</Button>
              <Button onClick={() => { setSuccess(false); setNewShipmentId(null); setSelectedPO(null); setPOItems([]); previewShipmentNumber(); }} variant="secondary">شحنة جديدة</Button>
              <Button onClick={() => router.push('/shipments')} variant="secondary">القائمة</Button>
            </div>
          </div>
        </div>
      </MainLayout>
    );
  }

  // ═════════════════════════════════════════════════════
  // ─── Main Form ──────────────────────────────────────
  // ═════════════════════════════════════════════════════
  return (
    <MainLayout>
      <Head><title>إنشاء شحنة جديدة - SLMS</title></Head>

      {/* Header */}
      <div className="mb-6">
        <button onClick={() => router.push('/shipments')}
          className="flex items-center gap-1 text-sm text-blue-600 dark:text-blue-400 hover:text-blue-800 mb-3 transition-colors">
          <ArrowLeftIcon className="w-4 h-4" /> العودة للقائمة
        </button>
        <div className="flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center">
              <TruckIcon className="w-6 h-6 text-white" />
            </div>
            <div>
              <h1 className="text-2xl font-bold text-gray-900 dark:text-white">إنشاء شحنة جديدة</h1>
              <p className="text-sm text-gray-500 dark:text-gray-400">Create a new shipment from PO, quotation, contract, or manually</p>
            </div>
          </div>
          <div className="hidden md:block w-48">
            <div className="text-xs text-gray-500 mb-1 text-right">اكتمال النموذج</div>
            <CompletionBar percent={completionPercent} />
          </div>
        </div>
      </div>

      {lookupLoading ? (
        <div className="flex items-center justify-center py-20">
          <ArrowPathIcon className="w-8 h-8 text-blue-500 animate-spin" />
          <span className="mr-3 text-gray-500">جاري تحميل البيانات...</span>
        </div>
      ) : (
        <form onSubmit={handleSubmit} className="max-w-4xl space-y-4 pb-12">

          {/* ─── Section 1: Data Source ─────────────────── */}
          <Section icon={ClipboardDocumentListIcon} title="مصدر البيانات | Data Source"
            subtitle="اختر كيف تريد إنشاء الشحنة — من أمر شراء (مُوصى) أو يدوياً">
            <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
              {SOURCE_TYPES.map((src) => {
                const SrcIcon = src.icon;
                const isActive = formData.source_type === src.value;
                return (
                  <button key={src.value} type="button" disabled={!src.ready}
                    onClick={() => {
                      updateField('source_type', src.value);
                      if (src.value !== 'purchase_order') { setSelectedPO(null); setPOItems([]); updateField('purchase_order_id', null); }
                    }}
                    className={`relative p-4 rounded-xl border-2 text-center transition-all ${
                      isActive ? 'border-blue-600 bg-blue-50 dark:bg-blue-900/20 shadow-md ring-1 ring-blue-300' :
                      src.ready ? 'border-gray-200 dark:border-gray-700 hover:border-blue-300 hover:shadow-sm' :
                      'border-gray-100 dark:border-gray-800 opacity-50 cursor-not-allowed'
                    }`}>
                    {!src.ready && <span className="absolute top-2 left-2 text-[9px] bg-gray-200 dark:bg-gray-700 text-gray-500 px-1.5 py-0.5 rounded">قريباً</span>}
                    <SrcIcon className={`w-7 h-7 mx-auto mb-2 ${isActive ? 'text-blue-600' : 'text-gray-400'}`} />
                    <div className={`text-xs font-semibold ${isActive ? 'text-blue-700 dark:text-blue-300' : 'text-gray-700 dark:text-gray-300'}`}>{src.labelAr}</div>
                    <div className="text-[10px] text-gray-400 mt-0.5">{src.label}</div>
                  </button>
                );
              })}
            </div>

            {/* PO Selection */}
            {formData.source_type === 'purchase_order' && (
              <div className="mt-4 space-y-3">
                <div>
                  <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">أمر الشراء *</label>
                  <select value={formData.purchase_order_id || ''}
                    onChange={(e) => { const id = e.target.value ? Number(e.target.value) : 0; if (id) handlePOSelection(id); else { setSelectedPO(null); setPOItems([]); updateField('purchase_order_id', null); } }}
                    className="w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm">
                    <option value="">-- اختر أمر شراء لتحميل بياناته تلقائياً --</option>
                    {purchaseOrders.map((po) => (
                      <option key={po.id} value={po.id}>
                        {po.order_number} — {po.vendor_display_name || po.vendor_name} ({Number(po.total_amount).toLocaleString()} {po.currency_code || ''})
                      </option>
                    ))}
                  </select>
                  <Hint>عند اختيار أمر شراء سيتم ملء المورد والمشروع والعملة والأصناف تلقائياً</Hint>
                </div>

                {selectedPO && (
                  <div className="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/10 dark:to-indigo-900/10 border border-blue-200 dark:border-blue-800 rounded-xl p-4">
                    <div className="flex items-center gap-2 mb-3">
                      <CheckCircleIcon className="w-5 h-5 text-emerald-500" />
                      <span className="text-sm font-semibold text-blue-900 dark:text-blue-100">تم تحميل أمر الشراء</span>
                    </div>
                    <div className="grid grid-cols-2 md:grid-cols-4 gap-2 text-xs">
                      {[
                        { label: 'رقم الأمر', value: selectedPO.order_number },
                        { label: 'المورد', value: selectedPO.vendor_display_name || selectedPO.vendor_name || '' },
                        { label: 'الإجمالي', value: `${Number(selectedPO.total_amount).toLocaleString()} ${selectedPO.currency_code || ''}` },
                        { label: 'عدد الأصناف', value: `${poItems.length} صنف` },
                      ].map(({ label, value }) => (
                        <div key={label} className="bg-white/70 dark:bg-gray-800/50 rounded-lg p-2">
                          <div className="text-gray-500 dark:text-gray-400">{label}</div>
                          <div className="font-semibold text-gray-900 dark:text-white truncate">{value}</div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            )}

            {/* Manual: Vendor Selection */}
            {formData.source_type === 'manual' && (
              <div className="mt-4">
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">المورد | Vendor</label>
                <select value={formData.vendor_id || ''}
                  onChange={(e) => updateField('vendor_id', e.target.value ? Number(e.target.value) : null)}
                  className="w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm">
                  <option value="">-- اختر المورد (اختياري) --</option>
                  {vendors.map((v) => (
                    <option key={v.id} value={v.id}>{v.code && !v.code.startsWith('_') ? `${v.code} - ` : ''}{v.name_ar || v.name}</option>
                  ))}
                </select>
                <Hint>يمكنك ربط الشحنة بمورد لتتبع المشتريات والمدفوعات</Hint>
              </div>
            )}
          </Section>

          {/* ─── Section 2: Core Information ────────────── */}
          <Section icon={DocumentTextIcon} title="المعلومات الأساسية | Core Information"
            subtitle="الحقول المطلوبة لإنشاء الشحنة">
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <Input label="رقم الشحنة *" type="text" placeholder="SHP-2024-001"
                  value={formData.shipment_number}
                  onChange={(e) => updateField('shipment_number', e.target.value)}
                  error={formErrors.shipment_number} />
                <Hint>رقم تسلسلي تلقائي — يمكنك تعديله</Hint>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">نوع الشحنة *</label>
                <select value={formData.shipment_type_id}
                  onChange={(e) => updateField('shipment_type_id', e.target.value ? Number(e.target.value) : '')}
                  className={`w-full px-3 py-2.5 border rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm ${formErrors.shipment_type_id ? 'border-red-400' : 'border-gray-300 dark:border-gray-600'}`}>
                  <option value="">اختر نوع الشحنة</option>
                  {shipmentTypes.filter(x => x.is_active).map(st => (
                    <option key={st.id} value={st.id}>
                      {st.code?.toLowerCase().includes('sea') ? '🚢' : st.code?.toLowerCase().includes('air') ? '✈️' : '🚛'} {st.name_en} ({st.name_ar})
                    </option>
                  ))}
                </select>
                {formErrors.shipment_type_id && <p className="mt-1 text-xs text-red-500">{formErrors.shipment_type_id}</p>}
                <Hint>يحدد نوع الموانئ المتاحة تلقائياً (بحري ← موانئ، جوي ← مطارات)</Hint>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">المشروع *</label>
                <select value={formData.project_id} disabled={isPOSourced}
                  onChange={(e) => updateField('project_id', e.target.value ? Number(e.target.value) : '')}
                  className={`w-full px-3 py-2.5 border rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm disabled:opacity-50 ${formErrors.project_id ? 'border-red-400' : 'border-gray-300 dark:border-gray-600'}`}>
                  <option value="">اختر المشروع</option>
                  {projects.map(p => <option key={p.id} value={p.id}>{p.code} — {p.name_en || p.name}</option>)}
                </select>
                {formErrors.project_id && <p className="mt-1 text-xs text-red-500">{formErrors.project_id}</p>}
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">شروط التسليم (Incoterm) *</label>
                <select value={formData.incoterm}
                  onChange={(e) => updateField('incoterm', e.target.value)}
                  className={`w-full px-3 py-2.5 border rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm ${formErrors.incoterm ? 'border-red-400' : 'border-gray-300 dark:border-gray-600'}`}>
                  <option value="">اختر شروط التسليم</option>
                  {incoterms.filter(i => i.is_active).map(inc => (
                    <option key={inc.id} value={inc.code}>{inc.code} — {inc.name} ({inc.name_ar})</option>
                  ))}
                </select>
                {formErrors.incoterm && <p className="mt-1 text-xs text-red-500">{formErrors.incoterm}</p>}
                <Hint>الافتراضي FOB — حدد من يتحمل تكاليف الشحن والتأمين</Hint>
              </div>
            </div>
          </Section>

          {/* ─── Section 3: Ports & Locations ──────────── */}
          <Section icon={MapPinIcon} title="المنشأ والوجهة | Origin & Destination"
            subtitle="حدد بلد ومدينة المنشأ والوجهة وميناء الوصول">
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">بلد المنشأ *</label>
                <select value={formData.origin_country_id}
                  onChange={(e) => handleOriginCountryChange(e.target.value ? Number(e.target.value) : 0)}
                  className={`w-full px-3 py-2.5 border rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm ${formErrors.origin_country_id ? 'border-red-400' : 'border-gray-300 dark:border-gray-600'}`}>
                  <option value="">اختر بلد المنشأ</option>
                  {countries.filter(c => c.is_active !== false).map(c => (
                    <option key={c.id} value={c.id}>{c.code} — {c.name_en || c.name} ({c.name_ar || ''})</option>
                  ))}
                </select>
                {formErrors.origin_country_id && <p className="mt-1 text-xs text-red-500">{formErrors.origin_country_id}</p>}
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">مدينة المنشأ *</label>
                <select value={formData.origin_location_id} disabled={!formData.origin_country_id}
                  onChange={(e) => updateField('origin_location_id', e.target.value ? Number(e.target.value) : '')}
                  className={`w-full px-3 py-2.5 border rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm disabled:opacity-40 ${formErrors.origin_location_id ? 'border-red-400' : 'border-gray-300 dark:border-gray-600'}`}>
                  <option value="">{formData.origin_country_id ? 'اختر المدينة' : 'اختر البلد أولاً'}</option>
                  {originCities.filter(c => c.is_active).map(c => (
                    <option key={c.id} value={c.id}>{c.name_en || c.name} ({c.name_ar || ''})</option>
                  ))}
                </select>
                {formErrors.origin_location_id && <p className="mt-1 text-xs text-red-500">{formErrors.origin_location_id}</p>}
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  بلد الوصول * <span className="text-blue-500 text-xs">(السعودية افتراضياً)</span>
                </label>
                <select value={formData.destination_country_id}
                  onChange={(e) => handleDestinationCountryChange(e.target.value ? Number(e.target.value) : 0)}
                  className={`w-full px-3 py-2.5 border rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm ${formErrors.destination_country_id ? 'border-red-400' : 'border-gray-300 dark:border-gray-600'}`}>
                  <option value="">اختر بلد الوصول</option>
                  {countries.filter(c => c.is_active !== false).map(c => (
                    <option key={c.id} value={c.id}>{c.code} — {c.name_en || c.name} ({c.name_ar || ''})</option>
                  ))}
                </select>
                {formErrors.destination_country_id && <p className="mt-1 text-xs text-red-500">{formErrors.destination_country_id}</p>}
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">مدينة الوصول *</label>
                <select value={formData.destination_location_id} disabled={!formData.destination_country_id}
                  onChange={(e) => updateField('destination_location_id', e.target.value ? Number(e.target.value) : '')}
                  className={`w-full px-3 py-2.5 border rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm disabled:opacity-40 ${formErrors.destination_location_id ? 'border-red-400' : 'border-gray-300 dark:border-gray-600'}`}>
                  <option value="">{formData.destination_country_id ? 'اختر المدينة' : 'اختر البلد أولاً'}</option>
                  {destinationCities.filter(c => c.is_active).map(c => (
                    <option key={c.id} value={c.id}>{c.name_en || c.name} ({c.name_ar || ''})</option>
                  ))}
                </select>
                {formErrors.destination_location_id && <p className="mt-1 text-xs text-red-500">{formErrors.destination_location_id}</p>}
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                  ميناء الشحن <span className="text-gray-400 text-xs">(اختياري)</span>
                </label>
                <select value={formData.port_of_loading_id}
                  onChange={(e) => { updateField('port_of_loading_id', e.target.value ? Number(e.target.value) : ''); updateField('port_of_loading_text', ''); }}
                  className="w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm">
                  <option value="">اختر أو اكتب أدناه</option>
                  {filteredPorts.map(p => (
                    <option key={p.id} value={p.id}>{p.port_type === 'sea' ? '🚢' : p.port_type === 'air' ? '✈️' : '🚛'} {p.name_en} — {p.name_ar}</option>
                  ))}
                </select>
                {!formData.port_of_loading_id && (
                  <input type="text" placeholder="أو اكتب اسم الميناء يدوياً" value={formData.port_of_loading_text}
                    onChange={(e) => { updateField('port_of_loading_text', e.target.value); updateField('port_of_loading_id', ''); }}
                    className="mt-1 w-full px-3 py-2 border border-gray-200 dark:border-gray-700 rounded-lg bg-white dark:bg-gray-700 text-sm text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500" />
                )}
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">ميناء الوصول *</label>
                <select value={formData.port_of_discharge_id}
                  onChange={(e) => updateField('port_of_discharge_id', e.target.value ? Number(e.target.value) : '')}
                  className={`w-full px-3 py-2.5 border rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm ${formErrors.port_of_discharge_id ? 'border-red-400' : 'border-gray-300 dark:border-gray-600'}`}>
                  <option value="">اختر ميناء الوصول</option>
                  {filteredPorts.map(p => (
                    <option key={p.id} value={p.id}>
                      {p.port_type === 'sea' ? '🚢' : p.port_type === 'air' ? '✈️' : '🚛'} {p.name_ar} ({p.name_en})
                    </option>
                  ))}
                </select>
                {formErrors.port_of_discharge_id && <p className="mt-1 text-xs text-red-500">{formErrors.port_of_discharge_id}</p>}
                <Hint>سيتم فلترة الموانئ تلقائياً حسب نوع الشحنة المختار</Hint>
              </div>
            </div>
          </Section>

          {/* ─── Section 4: Financial ──────────────────── */}
          <Section icon={CurrencyDollarIcon} title="المعلومات المالية | Financial"
            subtitle="العملة وطريقة الدفع والمبلغ" defaultOpen={formData.source_type !== 'purchase_order' || !!selectedPO}>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">العملة</label>
                <CurrencySelector
                  value={formData.currency_id ? Number(formData.currency_id) : null}
                  onChange={(id) => updateField('currency_id', id || '')}
                  onCurrencyCodeChange={setSelectedCurrencyCode}
                  companyId={getCompanyId()} />
                <Hint>الافتراضي: الريال السعودي (SAR)</Hint>
              </div>

              <ExchangeRateField
                currencyCode={selectedCurrencyCode}
                value={formData.exchange_rate}
                onChange={(v) => updateField('exchange_rate', v)}
                hideWhenBaseCurrency={true}
                label="سعر الصرف" />

              <div className="md:col-span-2">
                <PaymentMethodSelector
                  paymentMethodId={formData.payment_method_id}
                  onPaymentMethodChange={(id, type) => { updateField('payment_method_id', id); updateField('payment_method_type', type); }}
                  onBankAccountChange={() => {}}
                  companyId={getCompanyId() || 0}
                  label="طريقة الدفع"
                  disabled={isPOSourced}
                  showInlineFields={true} />
              </div>

              {(formData.payment_method_type?.toLowerCase().includes('lc') || formData.payment_method_type?.toLowerCase().includes('letter')) && (
                <div>
                  <Input label="رقم الاعتماد المستندي *" type="text" placeholder="LC-2024-001"
                    value={formData.lc_number} onChange={(e) => updateField('lc_number', e.target.value)}
                    error={formErrors.lc_number} />
                  <Hint>مطلوب عند اختيار الاعتماد المستندي كطريقة دفع</Hint>
                </div>
              )}

              <div>
                <Input label="المبلغ الإجمالي" type="number" placeholder="0.00"
                  value={formData.total_amount} disabled={isPOSourced}
                  onChange={(e) => updateField('total_amount', Number(e.target.value))} />
                {isPOSourced && <Hint>القيمة محسوبة تلقائياً من أمر الشراء</Hint>}
              </div>
            </div>
          </Section>

          {/* ─── Section 5: Shipping & Logistics ───────── */}
          <Section icon={TruckIcon} title="الشحن والخدمات اللوجستية | Shipping & Logistics"
            subtitle="وكيل الشحن، المستودع، تفاصيل البضاعة" defaultOpen={false} badge="اختياري">
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">وكيل الشحن</label>
                <select value={formData.shipping_agent_id}
                  onChange={(e) => updateField('shipping_agent_id', e.target.value ? Number(e.target.value) : '')}
                  className="w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm">
                  <option value="">اختر وكيل الشحن</option>
                  {shippingAgents.filter(a => a.is_active !== false).map(a => (
                    <option key={a.id} value={a.id}>{a.code} — {a.name} ({a.name_ar})</option>
                  ))}
                </select>
                <Hint>يمكنك تعيين وكيل الشحن لاحقاً من صفحة التفاصيل</Hint>
              </div>

              <div>
                <WarehouseSelector value={formData.warehouse_id}
                  onChange={(val) => updateField('warehouse_id', val)}
                  label="المستودع المُستلم" />
                <Hint>المستودع الذي سيتم استلام البضاعة فيه</Hint>
              </div>

              <Input label="وصف البضاعة" type="text" placeholder="مثال: معدات إلكترونية، قطع غيار..."
                value={formData.cargo_description} onChange={(e) => updateField('cargo_description', e.target.value)} />

              <Input label="الوزن الإجمالي (كجم)" type="number" placeholder="0.00"
                value={formData.total_weight_kg} onChange={(e) => updateField('total_weight_kg', e.target.value)} />

              <Input label="الحجم الإجمالي (م³)" type="number" placeholder="0.00"
                value={formData.total_volume_cbm} onChange={(e) => updateField('total_volume_cbm', e.target.value)} />

              <Input label="عدد الطرود" type="number" placeholder="0"
                value={formData.packages_count} onChange={(e) => updateField('packages_count', e.target.value)} />
            </div>
          </Section>

          {/* ─── Section 6: Documents & Dates ──────────── */}
          <Section icon={DocumentTextIcon} title="المستندات والتواريخ | Documents & Dates"
            subtitle="رقم البوليصة والتواريخ — يمكن إضافتها لاحقاً" defaultOpen={false} badge="اختياري">
            <div className="bg-amber-50 dark:bg-amber-900/10 border border-amber-200 dark:border-amber-800 rounded-lg p-3 mb-3">
              <div className="flex items-start gap-2">
                <InformationCircleIcon className="w-4 h-4 text-amber-600 mt-0.5 flex-shrink-0" />
                <p className="text-xs text-amber-700 dark:text-amber-400">
                  أرقام بوالص الشحن والتواريخ ليست مطلوبة عند الإنشاء. يمكنك إضافتها لاحقاً من صفحة تفاصيل الشحنة عندما تتوفر المعلومات.
                </p>
              </div>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <Input label="رقم بوليصة الشحن (B/L)" type="text" placeholder="BOL-XXXX-XXXX"
                value={formData.bl_no} onChange={(e) => updateField('bl_no', e.target.value)} />
              <Input label="رقم بوليصة الشحن الجوي (AWB)" type="text" placeholder="AWB-XXXX-XXXX"
                value={formData.awb_no} onChange={(e) => updateField('awb_no', e.target.value)} />
              <Input label="تاريخ المغادرة" type="date"
                value={formData.departure_date} onChange={(e) => updateField('departure_date', e.target.value)} />
              <Input label="تاريخ الوصول المتوقع" type="date"
                value={formData.expected_arrival_date} onChange={(e) => updateField('expected_arrival_date', e.target.value)} />
            </div>
          </Section>

          {/* ─── Section 7: Status & Notes ─────────────── */}
          <Section icon={GlobeAltIcon} title="الحالة والملاحظات | Status & Notes"
            subtitle="الحالة الابتدائية وأي ملاحظات إضافية" defaultOpen={false}>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">الحالة الابتدائية</label>
                <select value={formData.status_code}
                  onChange={(e) => updateField('status_code', e.target.value)}
                  className="w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm">
                  <option value="draft">مسودة (Draft) — الافتراضي</option>
                  {shipmentStatuses.filter(s => s.code !== 'draft').map(s => (
                    <option key={s.id} value={s.code}>{s.name_ar} ({s.name_en})</option>
                  ))}
                </select>
                <Hint>الشحنة تبدأ كمسودة افتراضياً — يمكنك تغيير الحالة لاحقاً</Hint>
              </div>

              <div>
                <label className="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">المرحلة</label>
                <select value={formData.stage_code}
                  onChange={(e) => updateField('stage_code', e.target.value)}
                  className="w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-blue-500 text-sm">
                  <option value="">بدون تحديد</option>
                  {shipmentStages.map(s => (
                    <option key={s.id} value={s.code}>{s.name_ar} ({s.name_en})</option>
                  ))}
                </select>
              </div>

              <div className="md:col-span-2">
                <Input label="ملاحظات" multiline rows={3} placeholder="أي ملاحظات إضافية على الشحنة..."
                  value={formData.notes} onChange={(e) => updateField('notes', e.target.value)} />
              </div>
            </div>
          </Section>

          {/* ─── PO Items Preview ──────────────────────── */}
          {selectedPO && poItems.length > 0 && (
            <Section icon={CubeIcon} title={`أصناف أمر الشراء (${poItems.length} صنف)`}
              subtitle="سيتم نسخها تلقائياً إلى الشحنة الجديدة">
              <div className="overflow-x-auto -mx-5">
                <table className="w-full text-sm">
                  <thead className="bg-gray-50 dark:bg-gray-700/50">
                    <tr>
                      <th className="px-4 py-2 text-right text-xs font-medium text-gray-500">#</th>
                      <th className="px-4 py-2 text-right text-xs font-medium text-gray-500">SKU</th>
                      <th className="px-4 py-2 text-right text-xs font-medium text-gray-500">الصنف</th>
                      <th className="px-4 py-2 text-right text-xs font-medium text-gray-500">الكمية</th>
                      <th className="px-4 py-2 text-right text-xs font-medium text-gray-500">الوحدة</th>
                      <th className="px-4 py-2 text-right text-xs font-medium text-gray-500">السعر</th>
                      <th className="px-4 py-2 text-right text-xs font-medium text-gray-500">الإجمالي</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-gray-100 dark:divide-gray-700">
                    {poItems.map((item, idx) => (
                      <tr key={item.id} className="hover:bg-gray-50 dark:hover:bg-gray-700/30">
                        <td className="px-4 py-2 text-gray-400 text-xs">{idx + 1}</td>
                        <td className="px-4 py-2 font-mono text-xs text-gray-600">{item.sku}</td>
                        <td className="px-4 py-2">
                          <div className="text-sm text-gray-900 dark:text-white">{item.name_ar || item.name_en}</div>
                          {item.name_en && item.name_ar && <div className="text-xs text-gray-400">{item.name_en}</div>}
                        </td>
                        <td className="px-4 py-2 text-right font-medium">{Number(item.quantity).toLocaleString()}</td>
                        <td className="px-4 py-2 text-gray-500">{item.unit_code}</td>
                        <td className="px-4 py-2 text-right">{Number(item.unit_price).toLocaleString(undefined, { minimumFractionDigits: 2 })}</td>
                        <td className="px-4 py-2 text-right font-semibold text-blue-600 dark:text-blue-400">
                          {(Number(item.unit_price) * Number(item.quantity)).toLocaleString(undefined, { minimumFractionDigits: 2 })}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                  <tfoot>
                    <tr className="bg-blue-50 dark:bg-blue-900/20 font-semibold">
                      <td colSpan={5} className="px-4 py-2 text-right text-sm">إجمالي أمر الشراء</td>
                      <td colSpan={2} className="px-4 py-2 text-right text-blue-700 dark:text-blue-300">
                        {Number(selectedPO.total_amount).toLocaleString(undefined, { minimumFractionDigits: 2 })} {selectedPO.currency_code || ''}
                      </td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </Section>
          )}

          {/* ─── Validation Summary ────────────────────── */}
          {Object.keys(formErrors).length > 0 && (
            <div className="bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800 rounded-xl p-4">
              <div className="flex items-center gap-2 mb-2">
                <ExclamationTriangleIcon className="w-5 h-5 text-red-500" />
                <span className="text-sm font-semibold text-red-700 dark:text-red-400">يرجى تصحيح الأخطاء التالية</span>
              </div>
              <ul className="space-y-1">
                {Object.values(formErrors).map((err, i) => (
                  <li key={i} className="text-xs text-red-600 dark:text-red-400">• {err}</li>
                ))}
              </ul>
            </div>
          )}

          {/* ─── Submit ────────────────────────────────── */}
          <div className="flex items-center justify-between pt-4 border-t border-gray-200 dark:border-gray-700">
            <Button type="button" variant="secondary" onClick={() => router.push('/shipments')} disabled={loading}>
              إلغاء
            </Button>
            <div className="flex items-center gap-3">
              <span className="text-xs text-gray-400 hidden md:block">
                {completionPercent < 70 ? 'بعض الحقول المهمة لم تُملأ بعد' : 'النموذج مكتمل'}
              </span>
              <Button type="submit" variant="primary" loading={loading} disabled={loading}>
                {formData.purchase_order_id ? 'إنشاء من أمر الشراء' : 'إنشاء الشحنة'}
              </Button>
            </div>
          </div>

        </form>
      )}
    </MainLayout>
  );
}

export default withPermission(MenuPermissions.Logistics.Shipments.Create, CreateShipmentPage);
